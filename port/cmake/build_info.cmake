# Writes OUT (a C++ source) with the git commit and dirty state of the port/ sources being compiled. Run at every
# build (see CMakeLists.txt); the file is rewritten only when the values change, so unchanged builds stay incremental.
execute_process(COMMAND git -C "${SRC}" rev-parse HEAD OUTPUT_VARIABLE sha ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR sha STREQUAL "")
  set(sha "unknown")
  set(dirty "unknown")
else()
  execute_process(COMMAND git -C "${SRC}" status --porcelain -- . OUTPUT_VARIABLE st ERROR_QUIET
                  OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(st STREQUAL "")
    set(dirty "false")
  else()
    set(dirty "true")
  endif()
endif()
set(text "// Generated by cmake/build_info.cmake. Do not edit.\nnamespace coinflip {\nconst char* build_git_sha() { return \"${sha}\"; }\nconst char* build_git_dirty() { return \"${dirty}\"; }\n}  // namespace coinflip\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT "${old}" STREQUAL "${text}")
  file(WRITE "${OUT}" "${text}")
endif()
